{
  "title": "Delhi AQI Predictor — App Metrics",
  "uid": "delhi-aqi-dashboard",
  "schemaVersion": 38,
  "version": 1,
  "panels": [
    {
      "id": 1,
      "title": "Total Predictions Requested",
      "type": "stat",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 6 },
      "targets": [
        {
          "expr": "delhi_aqi_predictions_total",
          "legendFormat": "predictions"
        }
      ]
    },
    {
      "id": 2,
      "title": "Latest Predicted PM2.5 (µg/m³)",
      "type": "stat",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 6 },
      "targets": [
        {
          "expr": "delhi_aqi_last_predicted_pm25",
          "legendFormat": "PM2.5"
        }
      ]
    },
    {
      "id": 3,
      "title": "Prediction Request Rate (per minute)",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 6 },
      "targets": [
        {
          "expr": "rate(delhi_aqi_predictions_total[1m]) * 60",
          "legendFormat": "req/min"
        }
      ]
    },
    {
      "id": 4,
      "title": "Streamlit App Status (1 = UP, 0 = DOWN)",
      "type": "stat",
      "gridPos": { "x": 0, "y": 6, "w": 6, "h": 6 },
      "targets": [
        {
          "expr": "up{job=\"delhi-aqi-streamlit\"}",
          "legendFormat": "App Up"
        }
      ]
    },
    {
      "id": 5,
      "title": "Python Memory Usage (Resident Bytes)",
      "type": "timeseries",
      "gridPos": { "x": 6, "y": 6, "w": 18, "h": 6 },
      "targets": [
        {
          "expr": "process_resident_memory_bytes{job=\"delhi-aqi-streamlit\"}",
          "legendFormat": "RAM Bytes"
        }
      ]
    }
  ]
}
