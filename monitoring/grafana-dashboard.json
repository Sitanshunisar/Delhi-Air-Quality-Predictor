{
  "title": "Delhi AQI Predictor — App Metrics",
  "uid": "delhi-aqi-dashboard",
  "schemaVersion": 38,
  "version": 1,
  "panels": [
    {
      "id": 1,
      "title": "HTTP Requests per Second",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "rate(flask_http_request_total[5m])",
          "legendFormat": "req/s"
        }
      ]
    },
    {
      "id": 2,
      "title": "Response Latency (p95)",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(flask_http_request_duration_seconds_bucket[5m]))",
          "legendFormat": "p95 latency"
        }
      ]
    },
    {
      "id": 3,
      "title": "Active Users (Streamlit)",
      "type": "stat",
      "gridPos": { "x": 0, "y": 8, "w": 6, "h": 4 },
      "targets": [
        {
          "expr": "streamlit_active_sessions",
          "legendFormat": "sessions"
        }
      ]
    },
    {
      "id": 4,
      "title": "Prediction Errors",
      "type": "stat",
      "gridPos": { "x": 6, "y": 8, "w": 6, "h": 4 },
      "targets": [
        {
          "expr": "sum(rate(flask_http_request_total{status=~\"5..\"}[5m]))",
          "legendFormat": "errors/s"
        }
      ]
    }
  ]
}
